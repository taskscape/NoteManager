<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NoteManager.Plugin.DocumentConversion</AssemblyName>
    <RootNamespace>NoteManager.Plugin.DocumentConversion</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoteManager.Core\NoteManager.Core.csproj" />
  </ItemGroup>

  <Target Name="DeployPluginBesideDesktop" AfterTargets="Build">
    <PropertyGroup>
      <PluginDeploymentDirectory>$(MSBuildThisFileDirectory)..\NoteManager.Desktop\bin\$(Configuration)\net10.0\Plugins\DocumentConversion</PluginDeploymentDirectory>
    </PropertyGroup>
    <ItemGroup>
      <PluginDeploymentFile Include="$(TargetPath)" />
      <PluginDeploymentFile Include="$(TargetDir)$(TargetName).pdb"
                            Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <RemoveDir Directories="$(TargetDir)Assets"
               Condition="Exists('$(TargetDir)Assets')" />
    <RemoveDir Directories="$(PluginDeploymentDirectory)\Assets"
               Condition="Exists('$(PluginDeploymentDirectory)\Assets')" />
    <MakeDir Directories="$(PluginDeploymentDirectory)" />
    <Copy SourceFiles="@(PluginDeploymentFile)"
          DestinationFolder="$(PluginDeploymentDirectory)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
