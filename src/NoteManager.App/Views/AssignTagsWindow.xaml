<Window x:Class="NoteManager.App.Views.AssignTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Assign Tags"
        Width="394"
        Height="532"
        MinWidth="370"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F4F4F4"
        FontFamily="Segoe UI"
        FontSize="11"
        AutomationProperties.AutomationId="AssignTagsWindow"
        AutomationProperties.Name="Assign Tags">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#B8BEC2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="TagListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="MinHeight" Value="16"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#E9F3FC"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F6FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="11,8,11,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="AssignmentHeading"
                   Margin="0,1,0,7"
                   FontSize="11.5"
                   Foreground="#111111"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="AssignTagsHeading"/>

        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RecentTagsButton"
                    Grid.Column="0"
                    Style="{StaticResource ModeButtonStyle}"
                    Background="#0078D4"
                    Foreground="White"
                    BorderBrush="#006CBE"
                    Click="RecentTagsButton_OnClick"
                    AutomationProperties.AutomationId="RecentTagsButton"
                    AutomationProperties.Name="50 most recently used tags"
                    Content="Recent 50"/>
            <Button x:Name="AllTagsButton"
                    Grid.Column="1"
                    Style="{StaticResource ModeButtonStyle}"
                    Margin="4,0,0,0"
                    Click="AllTagsButton_OnClick"
                    AutomationProperties.AutomationId="AllTagsButton"
                    AutomationProperties.Name="All repository tags"
                    Content="All tags"/>
            <Border Grid.Column="2"
                    Margin="6,0,0,0"
                    Height="21"
                    Background="White"
                    BorderBrush="#AEB6BB"
                    BorderThickness="1">
                <Grid>
                    <TextBox x:Name="TagSearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="5,0,18,0"
                             VerticalContentAlignment="Center"
                             FontSize="10"
                             TextChanged="TagSearchBox_OnTextChanged"
                             AutomationProperties.AutomationId="TagSearchBox"
                             AutomationProperties.Name="Search tags"/>
                    <TextBlock Text="Search tags"
                               Margin="5,0,18,0"
                               Foreground="#889298"
                               FontStyle="Italic"
                               FontSize="10"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TagSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="#66747A"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   x:Name="TagListDescription"
                   AutomationProperties.AutomationId="TagListDescription"
                   Margin="0,0,0,3"
                   FontSize="9.5"
                   Foreground="#66737A"
                   Text="50 most recently used tags in this folder"/>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#9FA8AD"
                BorderThickness="1">
            <ListBox x:Name="TagChecklist"
                     ItemsSource="{Binding VisibleTags, RelativeSource={RelativeSource AncestorType=Window}}"
                     ItemContainerStyle="{StaticResource TagListItemStyle}"
                     BorderThickness="0"
                     Background="White"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     AutomationProperties.AutomationId="TagChecklist"
                     AutomationProperties.Name="Available tags">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  MinHeight="15"
                                  Padding="1,0"
                                  FontSize="11"
                                  VerticalContentAlignment="Center"
                                  AutomationProperties.Name="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="4" Margin="0,6,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource DialogButtonStyle}"
                    Content="Select All"
                    Click="SelectAllButton_OnClick"
                    AutomationProperties.AutomationId="SelectAllTagsButton"/>
            <Button Grid.Column="1"
                    Margin="6,0,0,0"
                    Style="{StaticResource DialogButtonStyle}"
                    Content="Clear All"
                    Click="ClearAllButton_OnClick"
                    AutomationProperties.AutomationId="ClearAllTagsButton"/>
            <CheckBox Grid.Column="3"
                      x:Name="HideUnassignedTagsCheckBox"
                      Content="Hide unassigned tags"
                      VerticalAlignment="Center"
                      FontSize="10.5"
                      Click="HideUnassignedTagsCheckBox_OnClick"
                      AutomationProperties.AutomationId="HideUnassignedTagsCheckBox"/>
        </Grid>

        <TextBlock Grid.Row="5"
                   Margin="0,0,0,4"
                   Text="Add new tags:"
                   FontSize="11.5"
                   Foreground="#111111"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     x:Name="NewTagsTextBox"
                     Height="23"
                     Padding="5,0"
                     VerticalContentAlignment="Center"
                     FontSize="11"
                     KeyDown="NewTagsTextBox_OnKeyDown"
                     AutomationProperties.AutomationId="NewTagsTextBox"
                     AutomationProperties.Name="New tag names"/>
            <Button Grid.Column="1"
                    Margin="7,0,0,0"
                    Width="74"
                    Style="{StaticResource DialogButtonStyle}"
                    Content="Add"
                    Click="AddTagsButton_OnClick"
                    AutomationProperties.AutomationId="AddTagsButton"/>
        </Grid>

        <Grid Grid.Row="7" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TagInputHint"
                           Text="Enter several tags separated by spaces, commas, or semicolons. Letters, numbers, dots, and dashes are allowed."
                           TextWrapping="Wrap"
                           FontSize="8.5"
                           Foreground="#6C777D"/>
                <TextBlock x:Name="ValidationText"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           FontSize="9"
                           Foreground="#B42318"
                           Visibility="Collapsed"
                           AutomationProperties.AutomationId="TagValidationMessage"/>
                <TextBlock x:Name="SelectedCountText"
                           AutomationProperties.AutomationId="SelectedTagCountText"
                           Margin="0,2,0,0"
                           FontSize="9"
                           Foreground="#526168"/>
            </StackPanel>
            <StackPanel Grid.Row="1"
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="OkButton"
                        Width="74"
                        Style="{StaticResource DialogButtonStyle}"
                        BorderBrush="#0078D4"
                        IsDefault="True"
                        Content="OK"
                        Click="OkButton_OnClick"
                        AutomationProperties.AutomationId="AssignTagsOkButton"/>
                <Button Width="74"
                        Margin="7,0,0,0"
                        Style="{StaticResource DialogButtonStyle}"
                        IsCancel="True"
                        Content="Cancel"
                        AutomationProperties.AutomationId="AssignTagsCancelButton"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
