<UserControl x:Class="NoteManager.App.Controls.InteractivePdfViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             AutomationProperties.AutomationId="InteractivePdfViewer"
             AutomationProperties.Name="Interactive PDF viewer"
             SnapsToDevicePixels="True">
    <Border Background="#515659"
            BorderBrush="#AEB4B7"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#454A4D"
                    BorderBrush="#666C70"
                    BorderThickness="0,0,0,1">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="PDF"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Background="#D34A42"
                                   Padding="5,2"
                                   Margin="0,0,8,0"/>
                        <TextBlock x:Name="FileNameTextBlock"
                                   AutomationProperties.AutomationId="PdfFileName"
                                   Foreground="White"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            AutomationProperties.AutomationId="OpenPdfExternallyButton"
                            Height="28"
                            Padding="10,0"
                            Background="#5B6266"
                            BorderBrush="#747B7F"
                            Foreground="White"
                            Cursor="Hand"
                            AutomationProperties.Name="Open PDF externally"
                            ToolTip="Open this PDF in the default application"
                            Click="OpenExternallyButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Open PDF"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <wv2:WebView2 x:Name="PdfWebView"
                          Grid.Row="1"
                          AutomationProperties.AutomationId="PdfWebView"
                          AutomationProperties.Name="Interactive PDF document"
                          DefaultBackgroundColor="White"/>

            <Border x:Name="StatusOverlay"
                    Grid.Row="1"
                    Background="#F4F5F5">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="600">
                    <ProgressBar x:Name="LoadingProgressBar"
                                 Width="220"
                                 Height="3"
                                 IsIndeterminate="True"
                                 Foreground="#1787DF"/>
                    <TextBlock x:Name="StatusTextBlock"
                               AutomationProperties.AutomationId="PdfViewerStatusText"
                               Text="Loading interactive PDF viewer…"
                               Margin="0,12,0,0"
                               Foreground="#68757B"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
