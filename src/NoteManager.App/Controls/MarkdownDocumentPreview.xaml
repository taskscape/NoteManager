<UserControl x:Class="NoteManager.App.Controls.MarkdownDocumentPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NoteManager.App.Controls"
             SnapsToDevicePixels="True"
             AllowDrop="True">
    <ScrollViewer x:Name="DocumentScrollViewer"
                  Background="#FAFAFA"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="40,24,22,36"
                    MinWidth="910">
            <TextBlock Text="MARKDOWN SOURCE"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="#738087"
                       Margin="2,0,0,8"/>

            <Border Width="910"
                    HorizontalAlignment="Left"
                    Background="White"
                    BorderBrush="#C7CDD0"
                    BorderThickness="1">
                <TextBox Text="{Binding PlainTextContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Markdown plain text"
                         AutomationProperties.AutomationId="MarkdownEditor"
                         ToolTip="Drop PDF files here to embed them in this note"
                         AllowDrop="True"
                         IsReadOnly="False"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         FontSize="13"
                         TextBlock.LineHeight="20"
                         Foreground="#283A45"
                         Background="White"
                         BorderThickness="0"
                         Padding="28,26"
                         MinHeight="260"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Disabled"/>
            </Border>

            <TextBlock x:Name="PdfSectionHeading"
                       AutomationProperties.AutomationId="PdfSectionHeading"
                       Text="EMBEDDED PDF"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="#738087"
                       Margin="2,24,0,8"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="PdfStatusTextBlock"
                       AutomationProperties.AutomationId="PdfStatusText"
                       FontSize="12"
                       Foreground="#6C777C"
                       Margin="2,0,0,10"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <ItemsControl x:Name="PdfViewersItemsControl"
                          AutomationProperties.AutomationId="EmbeddedPdfViewers"
                          AutomationProperties.Name="Embedded PDF viewers"
                          Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:InteractivePdfViewer PdfPath="{Binding}"
                                                    Width="910"
                                                    Height="720"
                                                    Margin="0,0,0,16"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
