<UserControl x:Class="NoteManager.App.Controls.DocumentPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NoteManager.App.Controls"
             xmlns:models="clr-namespace:NoteManager.App.Models"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <DropShadowEffect x:Key="DocumentPageShadow"
                          BlurRadius="5"
                          Direction="270"
                          ShadowDepth="2"
                          Opacity=".28"/>

        <DataTemplate x:Key="SpaceManualTemplate"
                      DataType="{x:Type models:NoteItem}">
            <ScrollViewer Background="#FAFAFA"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="40,24,22,36"
                            MinWidth="970">
                    <Border Width="970"
                            HorizontalAlignment="Left"
                            Background="#515659"
                            BorderBrush="#B2B6B8"
                            BorderThickness="1"
                            Padding="15,60,15,48">
                        <StackPanel>
                            <Border Width="910"
                                    Height="670"
                                    Background="White"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="1"
                                    Effect="{StaticResource DocumentPageShadow}">
                                <Image Source="/NoteManager;component/Assets/orbital-workshop-cover.png"
                                       Margin="65,56"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <Border Width="910"
                                    Height="1287"
                                    Margin="0,12,0,0"
                                    Background="White"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="1"
                                    Effect="{StaticResource DocumentPageShadow}">
                                <Image Source="/NoteManager;component/Assets/orbital-workshop-assembly.png"
                                       Margin="18"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="StandardDocumentTemplate"
                      DataType="{x:Type models:NoteItem}">
            <ScrollViewer Background="#FAFAFA"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="40,8,22,36"
                            MinWidth="900">
                    <Button Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            AutomationProperties.Name="Open selected attachment"
                            HorizontalAlignment="Left"
                            Width="310"
                            Height="60"
                            Padding="0"
                            Background="White"
                            BorderBrush="#C8C8C8"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="Open generated sample file">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="36"
                                    CornerRadius="3"
                                    Background="#F2F6FB"
                                    BorderBrush="#C5D3E2"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Border Width="22"
                                            Height="15"
                                            Background="#185ABD"
                                            CornerRadius="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding AttachmentGlyph}"
                                               Foreground="White"
                                               FontSize="7.5"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,4"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                <TextBlock Text="{Binding FileName}"
                                           Foreground="#2A57A6"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11.5"
                                           Foreground="#2A57A6"
                                           Margin="0,4,0,0">
                                    <Run Text="{Binding ModifiedAt}"/>
                                    <Run Text=", "/>
                                    <Run Text="{Binding Size}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Border Margin="0,5,0,0"
                            Background="#515659"
                            BorderBrush="#B2B6B8"
                            BorderThickness="1"
                            Padding="65,60,65,84">
                        <Border Width="800"
                                Height="1100"
                                Background="White"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                Effect="{StaticResource DocumentPageShadow}">
                            <Grid Margin="84,82,84,74">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="78"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="78"/>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0"
                                            HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Border Width="31"
                                                Height="31"
                                                Background="#111"
                                                Margin="0,0,7,0">
                                            <TextBlock Text="N"
                                                       Foreground="White"
                                                       FontWeight="Black"
                                                       FontSize="22"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="NORTHSTAR"
                                                   FontFamily="Arial"
                                                   FontSize="25"
                                                   FontWeight="Black"
                                                   Foreground="#111"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="48 Lumen Street, Copenhagen, Denmark 2100"
                                               FontFamily="Times New Roman"
                                               FontSize="13.5"
                                               Margin="0,9,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Row="2"
                                        Background="#222"/>
                                <TextBlock Grid.Row="3"
                                           Text="{Binding ModifiedAt, StringFormat='Date: {0}'}"
                                           FontFamily="Times New Roman"
                                           FontSize="15"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"/>
                                <StackPanel Grid.Row="4"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DocumentHeading}"
                                               FontFamily="Times New Roman"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="{Binding DocumentSubheading}"
                                               FontFamily="Times New Roman"
                                               FontSize="13.5"
                                               FontStyle="Italic"
                                               TextAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                                <ItemsControl Grid.Row="5"
                                              ItemsSource="{Binding Paragraphs}"
                                              Margin="0,20,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="Times New Roman"
                                                       FontSize="17"
                                                       LineHeight="25"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Justify"
                                                       Margin="0,0,0,18"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="MarkdownDocumentTemplate"
                      DataType="{x:Type models:NoteItem}">
            <local:MarkdownDocumentPreview DataContext="{Binding}"/>
        </DataTemplate>
    </UserControl.Resources>

    <ContentControl Content="{Binding}">
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="ContentTemplate"
                        Value="{StaticResource StandardDocumentTemplate}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ThumbnailKind}"
                                 Value="{x:Static models:ThumbnailKind.SpacePoster}">
                        <Setter Property="ContentTemplate"
                                Value="{StaticResource SpaceManualTemplate}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMarkdownFile}"
                                 Value="True">
                        <Setter Property="ContentTemplate"
                                Value="{StaticResource MarkdownDocumentTemplate}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
</UserControl>
