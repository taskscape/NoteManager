<UserControl x:Class="NoteManager.App.Controls.DocumentThumbnail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:NoteManager.App.Models"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <RotateTransform x:Key="RotateMinus90" Angle="-90"/>

        <Style x:Key="TinyRule" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#6B6B6B"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <DataTemplate x:Key="GlobeTemplate">
            <Grid Background="#003927" ClipToBounds="True">
                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="64"
                           Foreground="#76CE95" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border BorderBrush="#5BE284" BorderThickness="1" Opacity=".35" Margin="18,12"/>
                <TextBlock Text="CLEAN ENERGY" Foreground="White" FontSize="7" FontWeight="SemiBold"
                           Margin="7" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ShippingTemplate">
            <Grid Background="White" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="37"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#222" BorderThickness="0,0,1,0" Margin="0,0,5,0">
                    <TextBlock Text="||| ||||| || |||||" FontFamily="Consolas" FontSize="7"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                               LayoutTransform="{StaticResource RotateMinus90}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="1">
                    <TextBlock Text="SHIP TO" FontSize="5" Foreground="#555"/>
                    <TextBlock Text="NORTHSTAR LABS" FontSize="7" FontWeight="Bold"/>
                    <TextBlock Text="WORKSHOP 4B" FontSize="5"/>
                    <Border Style="{StaticResource TinyRule}" Margin="0,4,0,2"/>
                    <TextBlock Text="PKG 482991" FontSize="8" FontWeight="Bold"/>
                    <TextBlock Text="||| ||| |||||| |||" FontFamily="Consolas" FontSize="10"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LegalTemplate">
            <Grid Background="#FFF">
                <StackPanel Margin="10,8">
                    <TextBlock Text="NORTHSTAR LABS" FontSize="6" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <Border Style="{StaticResource TinyRule}"/>
                    <TextBlock Text="STATEMENT" FontFamily="Georgia" FontSize="7" FontWeight="Bold"
                               Margin="0,5,0,2" HorizontalAlignment="Center"/>
                    <TextBlock FontFamily="Georgia" FontSize="3.8" TextWrapping="Wrap"
                               Text="This document confirms the agreed scope, responsibilities and review schedule for the programme. The parties will maintain clear records and publish a summary."/>
                    <TextBlock Text="Signed electronically" FontFamily="Segoe Script" FontSize="5"
                               Margin="0,6,3,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="InvoiceTemplate">
            <Grid Background="White">
                <StackPanel Margin="7,5">
                    <Grid>
                        <TextBlock Text="MERIDIAN" FontSize="7" FontWeight="Bold"/>
                        <TextBlock Text="INVOICE" FontSize="7" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="INV-2026-0715" FontSize="4.5" Foreground="#555" HorizontalAlignment="Right"/>
                    <Border Style="{StaticResource TinyRule}" Margin="0,3"/>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Service and supplies" FontSize="4.5"/>
                        <TextBlock Grid.Column="1" Text="245.00" FontSize="4.5" TextAlignment="Right"/>
                    </Grid>
                    <Border Style="{StaticResource TinyRule}"/>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Maintenance" FontSize="4.5"/>
                        <TextBlock Grid.Column="1" Text="89.50" FontSize="4.5" TextAlignment="Right"/>
                    </Grid>
                    <Border Style="{StaticResource TinyRule}"/>
                    <TextBlock Text="TOTAL 334.50" FontSize="6" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,3"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TableTemplate">
            <Grid Background="White" Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="13"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="Q3 OPERATING BUDGET" FontSize="6" FontWeight="Bold"/>
                <UniformGrid Grid.Row="1" Rows="5" Columns="4">
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="Dept" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="Plan" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="Actual" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="Var" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="Studio" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="18.2" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="17.8" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="+0.4" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="Travel" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="9.4" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="8.9" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="+0.5" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="Research" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="21.0" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="21.7" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="-0.7" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="Total" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="48.6" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="48.4" FontSize="4" Margin="1"/></Border>
                    <Border BorderBrush="#6A6A6A" BorderThickness=".5"><TextBlock Text="+0.2" FontSize="4" Margin="1"/></Border>
                </UniformGrid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SignedTemplate">
            <Grid Background="#FFFEFC">
                <StackPanel Margin="12,6">
                    <TextBlock Text="RIVERSIDE STUDIO" FontFamily="Georgia" FontSize="6" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Border Style="{StaticResource TinyRule}" Margin="0,3"/>
                    <TextBlock Text="Workspace lease and inventory schedule" FontFamily="Georgia" FontSize="4.2"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <Border Height="18"/>
                    <TextBlock Text="Alex Morgan" FontFamily="Segoe Script" FontSize="7"
                               HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <Border BorderBrush="#777" BorderThickness="0,1,0,0" Width="48" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SpaceTemplate">
            <Image Source="/NoteManager;component/Assets/orbital-workshop-cover.png"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </DataTemplate>

        <DataTemplate x:Key="ReceiptTemplate">
            <Grid Background="#FFF">
                <StackPanel Width="58" HorizontalAlignment="Center" Margin="4">
                    <TextBlock Text="MORNING FIELD" FontFamily="Consolas" FontSize="6" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="RECEIPT 04781" FontFamily="Consolas" FontSize="4.2" TextAlignment="Center"/>
                    <Border Style="{StaticResource TinyRule}" Margin="0,3"/>
                    <TextBlock Text="Coffee        12.00&#x0a;Breakfast     38.00&#x0a;Service        5.00" FontFamily="Consolas" FontSize="4.2"/>
                    <Border Style="{StaticResource TinyRule}" Margin="0,3"/>
                    <TextBlock Text="TOTAL 55.00" FontFamily="Consolas" FontSize="5.2" FontWeight="Bold" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReportTemplate">
            <Grid Background="#FFF">
                <Grid Margin="9,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="16"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="RESEARCH SYNTHESIS" FontSize="6" FontWeight="Bold"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,2,5,0">
                            <Border Height="3" Background="#4A7798" Margin="0,2"/>
                            <Border Height="2" Background="#9BA8AF" Margin="0,2"/>
                            <Border Height="2" Background="#9BA8AF" Margin="0,2"/>
                            <Border Height="2" Background="#9BA8AF" Margin="0,2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,2,0,0">
                            <Border Height="8" Background="#DCEAF1" Margin="0,1"/>
                            <Border Height="11" Background="#BFD5E0" Margin="0,1"/>
                            <Border Height="16" Background="#7DA2B5" Margin="0,1"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MarkdownTemplate">
            <Grid Background="#FFF">
                <StackPanel Margin="9,7">
                    <Grid>
                        <Border Width="24"
                                Height="27"
                                HorizontalAlignment="Left"
                                Background="#F3F6F8"
                                BorderBrush="#AEB9C0"
                                BorderThickness="1">
                            <TextBlock Text="MD"
                                       FontFamily="Consolas"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       Foreground="#3E5968"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MARKDOWN"
                                   FontSize="6"
                                   FontWeight="SemiBold"
                                   Foreground="#405867"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Style="{StaticResource TinyRule}" Margin="0,7,0,2"/>
                    <Border Height="2" Background="#A7B2B8" Margin="0,2"/>
                    <Border Height="2" Background="#C0C8CC" Margin="0,2"/>
                    <Border Height="2" Background="#C0C8CC" Margin="0,2" Width="72" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderBrush="#DADADA" BorderThickness="1" Background="White">
        <ContentControl Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource ReportTemplate}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="{x:Static models:ThumbnailKind.Globe}">
                            <Setter Property="ContentTemplate" Value="{StaticResource GlobeTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="{x:Static models:ThumbnailKind.ShippingLabel}">
                            <Setter Property="ContentTemplate" Value="{StaticResource ShippingTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="{x:Static models:ThumbnailKind.LegalLetter}">
                            <Setter Property="ContentTemplate" Value="{StaticResource LegalTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="{x:Static models:ThumbnailKind.Invoice}">
                            <Setter Property="ContentTemplate" Value="{StaticResource InvoiceTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="{x:Static models:ThumbnailKind.Table}">
                            <Setter Property="ContentTemplate" Value="{StaticResource TableTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="{x:Static models:ThumbnailKind.SignedLetter}">
                            <Setter Property="ContentTemplate" Value="{StaticResource SignedTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="{x:Static models:ThumbnailKind.SpacePoster}">
                            <Setter Property="ContentTemplate" Value="{StaticResource SpaceTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="{x:Static models:ThumbnailKind.Receipt}">
                            <Setter Property="ContentTemplate" Value="{StaticResource ReceiptTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="{x:Static models:ThumbnailKind.Report}">
                            <Setter Property="ContentTemplate" Value="{StaticResource ReportTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ThumbnailKind}" Value="{x:Static models:ThumbnailKind.Markdown}">
                            <Setter Property="ContentTemplate" Value="{StaticResource MarkdownTemplate}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Border>
</UserControl>
