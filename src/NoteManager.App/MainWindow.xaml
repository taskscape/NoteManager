<Window x:Class="NoteManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NoteManager.App.Controls"
        xmlns:infra="clr-namespace:NoteManager.App.Infrastructure"
        xmlns:models="clr-namespace:NoteManager.App.Models"
        mc:Ignorable="d"
        Title="All Notebooks - office@northstarlabs.example - NoteManager"
        AutomationProperties.AutomationId="NoteManagerMainWindow"
        AutomationProperties.Name="NoteManager"
        Width="1600"
        Height="960"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        AllowDrop="True"
        PreviewDragOver="NotePdf_OnPreviewDragOver"
        PreviewDrop="NotePdf_OnPreviewDrop">
    <Window.Resources>
        <infra:LevelToMarginConverter x:Key="LevelToMarginConverter"/>
        <infra:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <infra:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <DropShadowEffect x:Key="PageShadow" BlurRadius="5" Direction="270" ShadowDepth="2" Opacity=".28"/>

        <Style x:Key="TagItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#DADADA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TagItemTemplate" DataType="{x:Type models:NavigationItem}">
            <StackPanel Height="20"
                        Margin="43,0,10,0"
                        Orientation="Horizontal">
                <TextBlock
                           Text="{Binding Label}"
                           FontSize="11"
                           Foreground="#3C4C58"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Count}"
                           Margin="6,0,0,0"
                           FontSize="10.5"
                           Foreground="#A6AFB5"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="NoteItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding FileName}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="White"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#16A6D7"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F3F6F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormatButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#53585B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ThinSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#D9E1E5"/>
            <Setter Property="Margin" Value="5,3"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top"
              Height="23"
              Padding="2,0"
              Background="#FBFBFB"
              BorderBrush="#D9D9D9"
              BorderThickness="0,0,0,1"
              FontSize="12">
            <MenuItem Header="_File">
                <MenuItem Header="New note" Command="{Binding NewNoteCommand}" InputGestureText="Ctrl+N"/>
                <Separator/>
                <MenuItem Header="_Open folder…"
                          InputGestureText="Ctrl+O"
                          AutomationProperties.Name="Open folder"
                          Click="OpenFolderMenuItem_OnClick"/>
                <Separator/>
                <MenuItem Header="Import files…"/>
                <MenuItem Header="Export note…"/>
                <Separator/>
                <MenuItem Header="Exit" Click="ExitMenuItem_OnClick"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="Redo" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Find notes" InputGestureText="Ctrl+F" Click="FindMenuItem_OnClick"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Note list"/>
                <MenuItem Header="Cards"/>
                <MenuItem Header="Compact"/>
            </MenuItem>
            <MenuItem Header="_Note">
                <MenuItem Header="New note" Command="{Binding NewNoteCommand}"/>
                <MenuItem Header="Move note…"/>
                <MenuItem Header="Delete note" Click="DeleteNote_OnClick"/>
            </MenuItem>
            <MenuItem Header="F_ormat">
                <MenuItem Header="Bold"/>
                <MenuItem Header="Italic"/>
                <MenuItem Header="Underline"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Sync now" Command="{Binding SyncCommand}"/>
                <MenuItem Header="Options…"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Keyboard shortcuts"/>
                <MenuItem Header="About NoteManager"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Height="36"
                Background="White"
                BorderBrush="#D8D8D8"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ShareToolbarButton"
                        Grid.Column="0"
                        Command="{Binding ShareCommand}"
                        Style="{StaticResource ChromeButtonStyle}"
                        Padding="12,0"
                        ToolTip="Share selected note"
                        AutomationProperties.AutomationId="ShareToolbarButton"
                        AutomationProperties.Name="Share">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#6B777C"
                                   Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Share" FontSize="12" Foreground="#24333C" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Command="{Binding NewNoteCommand}"
                        Style="{StaticResource ChromeButtonStyle}"
                        Padding="12,0"
                        ToolTip="Create an empty Markdown note"
                        AutomationProperties.AutomationId="CreateToolbarButton"
                        AutomationProperties.Name="Create">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#6B777C"
                                   Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Create" FontSize="12" Foreground="#24333C" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Click="DeleteNote_OnClick"
                        IsEnabled="{Binding CanDeleteSelectedNote}"
                        Style="{StaticResource ChromeButtonStyle}"
                        Padding="12,0"
                        ToolTip="Permanently delete selected note"
                        AutomationProperties.AutomationId="DeleteToolbarButton"
                        AutomationProperties.Name="Delete">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#6B777C"
                                   Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Delete" FontSize="12" Foreground="#24333C" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Click="AssignTags_OnClick"
                        IsEnabled="{Binding CanAssignTags}"
                        Style="{StaticResource ChromeButtonStyle}"
                        Padding="12,0"
                        ToolTip="Assign tags to selected note"
                        AutomationProperties.AutomationId="TagsToolbarButton"
                        AutomationProperties.Name="Tags">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#6B777C"
                                   Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tags" FontSize="12" Foreground="#24333C" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,15,0">
                    <TextBlock Text="{Binding StatusText}"
                               AutomationProperties.AutomationId="ApplicationStatusText"
                               Foreground="#929DA3"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="SharePanelPopup"
               DataContext="{Binding DataContext, ElementName=ShareToolbarButton}"
               PlacementTarget="{Binding ElementName=ShareToolbarButton}"
               Placement="Bottom"
               HorizontalOffset="0"
               VerticalOffset="1"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="False"
               IsOpen="{Binding IsSharePanelOpen, Mode=TwoWay}">
            <Border Width="305"
                    Padding="17"
                    Background="White"
                    BorderBrush="#BFC7CB"
                    BorderThickness="1"
                    AutomationProperties.AutomationId="ShareNotePanel"
                    AutomationProperties.Name="Share note panel">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="4" Opacity=".22"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,13">
                        <TextBlock Text="Share note" FontSize="17" FontWeight="SemiBold"/>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource RoundIconButtonStyle}"
                                Command="{Binding CloseShareCommand}"
                                Content="×"
                                FontSize="18"
                                AutomationProperties.AutomationId="CloseSharePanelButton"
                                AutomationProperties.Name="Close sharing panel"/>
                    </Grid>
                    <TextBlock Text="{Binding SelectedNote.FileName}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#344550"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,9"/>
                    <TextBlock Text="Publish this Markdown note and its embedded attachments to Infostacker. Anyone with the generated link can view the published content."
                               FontSize="11.5"
                               Foreground="#68767C"
                               TextWrapping="Wrap"
                               LineHeight="17"
                               Margin="0,0,0,13"/>
                    <Button Height="34"
                            Background="#1687E6"
                            Foreground="White"
                            BorderThickness="0"
                            Content="{Binding ShareActionText}"
                            IsEnabled="{Binding CanPublishSelectedNote}"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            AutomationProperties.AutomationId="PublishPublicLinkButton"
                            AutomationProperties.Name="Publish and copy public link"
                            Click="PublishShareLinkButton_OnClick"/>
                    <TextBlock Text="{Binding ShareStatusText}"
                               MinHeight="34"
                               Margin="0,10,0,0"
                               FontSize="11"
                               Foreground="#5E6D74"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ShareStatusText"
                               AutomationProperties.Name="{Binding ShareStatusText}"/>
                </StackPanel>
            </Border>
        </Popup>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="550"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tag navigation -->
            <Grid Grid.Column="0" Background="#F4F4F4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="39"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                        Command="{Binding NewNoteCommand}"
                        AutomationProperties.Name="New note"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,6"
                        HorizontalContentAlignment="Left"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#00A82D">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="New Note" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"
                                   Foreground="#344550" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1"
                        Command="{Binding ClearTagFilterCommand}"
                        AutomationProperties.Name="Show all tags"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="21,0,0,0"
                        HorizontalContentAlignment="Left"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EC;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="#6F7477"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Tags"
                                   FontSize="15"
                                   Foreground="#394A55"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <ListBox Grid.Row="2"
                         x:Name="NavigationList"
                         AutomationProperties.AutomationId="NavigationList"
                         AutomationProperties.Name="Tags"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         ItemTemplate="{StaticResource TagItemTemplate}"
                         ItemContainerStyle="{StaticResource TagItemContainerStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"/>
            </Grid>

            <Border Grid.Column="1" Background="#D7D7D7"/>

            <!-- Note list -->
            <Grid Grid.Column="2" Background="#F8F8F8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="13,0,13,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="43"/>
                        <RowDefinition Height="33"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CenterHeading}"
                                   AutomationProperties.AutomationId="CenterHeadingText"
                                   FontSize="16"
                                   Foreground="#263946"/>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="#4D5457" Margin="7,5,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding VisibleNoteCount}"
                                   AutomationProperties.AutomationId="VisibleNoteCountText"
                                   FontSize="10.5"
                                   Foreground="#A4ADB3"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SearchIndexStatus}"
                                   AutomationProperties.AutomationId="SearchIndexStatusText"
                                   FontSize="10.5"
                                   Foreground="#2181C4"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.RowSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,7">
                        <Button Style="{StaticResource RoundIconButtonStyle}" Command="{Binding ViewModeCommand}" CommandParameter="Sorted by updated date"
                                ToolTip="Sort notes">
                            <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource RoundIconButtonStyle}" Command="{Binding ViewModeCommand}" CommandParameter="Card view selected"
                                AutomationProperties.AutomationId="CardViewButton"
                                ToolTip="Card view">
                            <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource RoundIconButtonStyle}" Command="{Binding ViewModeCommand}" CommandParameter="Tag filter ready"
                                ToolTip="Tags">
                            <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource RoundIconButtonStyle}" Command="{Binding ViewModeCommand}" CommandParameter="More note-list actions"
                                ToolTip="More">
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="10,4,10,5">
                    <Border BorderBrush="#C7CDD0" BorderThickness="1" Background="White">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     AutomationProperties.AutomationId="SearchBox"
                                     AutomationProperties.Name="Search notes"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="10,0,40,0"
                                     FontSize="11"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{Binding SearchIndexStatus}"/>
                            <TextBlock Text="Search notes"
                                       IsHitTestVisible="False"
                                       Margin="11,0,40,0"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="#8D999F"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="#68767C" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="#DFDFDF"/>

                <ListBox Grid.Row="3"
                         x:Name="NotesList"
                         AutomationProperties.AutomationId="NotesList"
                         AutomationProperties.Name="Notes"
                         ItemsSource="{Binding NotesView}"
                         SelectedItem="{Binding SelectedNote}"
                         ItemContainerStyle="{StaticResource NoteItemContainerStyle}"
                         Background="#F9F9F9"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:NoteItem}">
                            <Border Height="90"
                                    BorderBrush="#E2E2E2"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,4,9,3"
                                    AllowDrop="True"
                                    ToolTip="Drop PDF files here to embed them in this note">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="151"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,10,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="18"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="#243544" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Subtitle}" FontSize="9.5" Foreground="#A7B0B6"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ListAttachmentText}"
                                                       MaxWidth="280"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="10"
                                                       Foreground="#53636C"/>
                                            <TextBlock Text=",  " FontSize="10" Foreground="#53636C"/>
                                            <TextBlock Text="{Binding Size}" FontSize="10" Foreground="#53636C"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="3" Text="{Binding Date}" FontSize="10" Foreground="#A5AFB5" VerticalAlignment="Center"/>
                                    </Grid>
                                    <controls:DocumentThumbnail Grid.Column="1" Width="151" Height="80"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Column="3" Background="#D7D7D7"/>

            <!-- Active note editor and document preview -->
            <Grid Grid.Column="4" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,0,14,0">
                    <TextBox Text="{Binding SelectedNote.Title, Mode=OneWay}"
                             AutomationProperties.AutomationId="SelectedNoteTitle"
                             AutomationProperties.Name="{Binding SelectedNote.Title}"
                             BorderThickness="0" Background="Transparent" Foreground="#0577E4"
                             FontSize="12.5" VerticalContentAlignment="Center" Padding="0"
                             IsReadOnly="True"
                             IsTabStop="False"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Background="White">
                        <Button Style="{StaticResource ChromeButtonStyle}" Command="{Binding ShareCommand}"
                                AutomationProperties.Name="Share note">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#73797C" Margin="0,0,5,0"/>
                                <TextBlock Text="Share" FontSize="11" Foreground="#30393E" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="7,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RoundIconButtonStyle}" ToolTip="Note information">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#6C777C"/>
                        </Button>
                        <Button Style="{StaticResource RoundIconButtonStyle}" ToolTip="More actions">
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#6C777C"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="12,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Background="White" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNote.Date}" FontSize="10.5" Foreground="#6F7B80" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#6F7B80" Margin="5,2,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="A" FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold" Foreground="#2587D9"
                                   TextDecorations="Underline" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Background="#D7D7D7"/>

                <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Background="#FCFCFC">
                    <StackPanel Orientation="Horizontal" Margin="11,4">
                        <ComboBox Width="150" Height="30" Margin="0,0,2,0" SelectedIndex="0" FontSize="12">
                            <ComboBoxItem Content="Normal text"/>
                            <ComboBoxItem Content="Heading 1"/>
                            <ComboBoxItem Content="Heading 2"/>
                        </ComboBox>
                        <ComboBox Width="55" Height="30" SelectedIndex="0" FontSize="12">
                            <ComboBoxItem Content="12"/>
                            <ComboBoxItem Content="14"/>
                            <ComboBoxItem Content="18"/>
                        </ComboBox>
                        <Button Style="{StaticResource FormatButtonStyle}" Content="a"/>
                        <Button Style="{StaticResource FormatButtonStyle}" Content="▾" MinWidth="19" Padding="0"/>
                        <Button Style="{StaticResource FormatButtonStyle}" Content="B" FontWeight="Bold"/>
                        <Button Style="{StaticResource FormatButtonStyle}" Content="I" FontStyle="Italic"/>
                        <Button Style="{StaticResource FormatButtonStyle}">
                            <TextBlock Text="U" TextDecorations="Underline"/>
                        </Button>
                        <Button Style="{StaticResource FormatButtonStyle}" Content="T̶"/>
                        <Button Style="{StaticResource FormatButtonStyle}" ToolTip="Highlight">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                        </Button>
                        <Button Style="{StaticResource FormatButtonStyle}" Content="Code" FontFamily="Consolas" FontSize="9"/>
                        <Border Style="{StaticResource ThinSeparatorStyle}"/>
                        <Button Style="{StaticResource FormatButtonStyle}" Content="☷" FontSize="18"/>
                        <Button Style="{StaticResource FormatButtonStyle}" Content="☷" FontSize="18"/>
                        <Button Style="{StaticResource FormatButtonStyle}" ToolTip="Checklist">
