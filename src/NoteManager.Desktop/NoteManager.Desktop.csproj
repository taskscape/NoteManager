<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NoteManager</AssemblyName>
    <RootNamespace>NoteManager.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.333" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoteManager.Core\NoteManager.Core.csproj" />
    <ProjectReference Include="..\NoteManager.Plugin.DocumentConversion\NoteManager.Plugin.DocumentConversion.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NoteManager.Plugin.GitIntegration\NoteManager.Plugin.GitIntegration.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="PublishBundledPlugins" AfterTargets="Publish">
    <ItemGroup>
      <BundledPluginFile Include="..\NoteManager.Plugin.GitIntegration\bin\$(Configuration)\net10.0\NoteManager.Plugin.GitIntegration.dll" />
      <BundledPluginFile Include="..\NoteManager.Plugin.GitIntegration\bin\$(Configuration)\net10.0\NoteManager.Plugin.GitIntegration.pdb" Condition="Exists('..\NoteManager.Plugin.GitIntegration\bin\$(Configuration)\net10.0\NoteManager.Plugin.GitIntegration.pdb')" />
      <BundledDocumentConversionPluginFile Include="..\NoteManager.Plugin.DocumentConversion\bin\$(Configuration)\net10.0\NoteManager.Plugin.DocumentConversion.dll" />
      <BundledDocumentConversionPluginFile Include="..\NoteManager.Plugin.DocumentConversion\bin\$(Configuration)\net10.0\NoteManager.Plugin.DocumentConversion.pdb" Condition="Exists('..\NoteManager.Plugin.DocumentConversion\bin\$(Configuration)\net10.0\NoteManager.Plugin.DocumentConversion.pdb')" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)Plugins\GitIntegration" />
    <Copy SourceFiles="@(BundledPluginFile)" DestinationFolder="$(PublishDir)Plugins\GitIntegration" SkipUnchangedFiles="true" />
    <RemoveDir Directories="$(PublishDir)Plugins\DocumentConversion\Assets" Condition="Exists('$(PublishDir)Plugins\DocumentConversion\Assets')" />
    <MakeDir Directories="$(PublishDir)Plugins\DocumentConversion" />
    <Copy SourceFiles="@(BundledDocumentConversionPluginFile)" DestinationFolder="$(PublishDir)Plugins\DocumentConversion" SkipUnchangedFiles="true" />
  </Target>
</Project>
