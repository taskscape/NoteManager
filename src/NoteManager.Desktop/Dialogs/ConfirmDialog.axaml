<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:FluentIcons.Avalonia"
        x:Class="NoteManager.Desktop.Dialogs.ConfirmDialog"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        Title="Confirm">
  <Grid RowDefinitions="Auto,Auto">
    <Grid Margin="24,24,24,21"
          ColumnDefinitions="Auto,*"
          ColumnSpacing="15">
      <Border Width="42"
              Height="42"
              Background="#18D63C45"
              CornerRadius="21">
        <icons:FluentIcon HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Icon="Delete"
                          IconSize="Size20"
                          Foreground="{DynamicResource DangerBrush}" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="7">
        <TextBlock FontSize="20"
                   FontWeight="SemiBold"
                   Text="Delete this note?" />
        <TextBlock x:Name="MessageText"
                   Classes="secondary"
                   LineHeight="21"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1"
            Padding="24,15"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Right"
                  Orientation="Horizontal"
                  Spacing="10">
        <Button Classes="command"
                Click="Cancel_OnClick"
                Content="Cancel" />
        <Button Classes="destructive"
                Click="Confirm_OnClick"
                Content="Delete note" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
