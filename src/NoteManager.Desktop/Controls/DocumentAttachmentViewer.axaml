<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia"
             x:Class="NoteManager.Desktop.Controls.DocumentAttachmentViewer">
  <!-- Related files without an inline renderer remain visible and can be
       opened with the operating system's associated application. -->
  <Border Padding="14"
          Background="{DynamicResource PanelBackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="8">
    <Grid ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="12">
      <Border Width="42"
              Height="42"
              Background="{DynamicResource SubtleSurfaceBrush}"
              CornerRadius="7">
        <icons:FluentIcon HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Icon="Document"
                          IconSize="Size20" />
      </Border>
      <StackPanel Grid.Column="1"
                  VerticalAlignment="Center"
                  Spacing="3">
        <TextBlock x:Name="FileNameText"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="FileTypeText"
                   Classes="secondary"
                   FontSize="11" />
      </StackPanel>
      <Button Grid.Column="2"
              VerticalAlignment="Center"
              Classes="command"
              Click="OpenExternally_OnClick">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <icons:FluentIcon Icon="Open" IconSize="Size16" />
          <TextBlock VerticalAlignment="Center" Text="Open" />
        </StackPanel>
      </Button>
    </Grid>
  </Border>
</UserControl>
